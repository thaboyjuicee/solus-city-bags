generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  wallet    String   @unique
  createdAt DateTime @default(now())

  profile           Profile?
  inventory         Inventory[]
  attacksMade       Battle[]         @relation("Attacker")
  attacksReceived   Battle[]         @relation("Defender")
  cooldownsGiven    AttackCooldown[] @relation("CooldownAttacker")
  cooldownsReceived AttackCooldown[] @relation("CooldownDefender")
  events            EventLog[]
  attackLogs        AttackLog[]
  protectionEffects ProtectionEffect[]
  syndicateMembership SyndicateMember?
  ledSyndicate      Syndicate?        @relation("SyndicateLeader")
  slsTransactions   SlsTransaction[]
  blackMarketPurchases BlackMarketPurchase[]
  playerMissions    PlayerMission[]
  playerPerks       PlayerPerk[]
  revengeMarksAsVictim   RevengeMark[] @relation("RevengeVictim")
  revengeMarksAsAttacker RevengeMark[] @relation("RevengeAttacker")
  seasonParticipations   SeasonParticipation[]
  seasonLeaderboardSnapshots SeasonLeaderboardSnapshot[]
  prestigeHistory       PrestigeHistory[]
  hallOfFameEntries     HallOfFameEntry[]
  territoryContributions TerritoryContribution[]
  warActions         SyndicateWarAction[]
}

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  name         String   @default("")
  cash         Float    @default(1000)
  vaultCash    Float    @default(0)
  rp           Int      @default(100)
  heat         Int      @default(0)
  wantedTier   String   @default("low")
  seasonScore  Int      @default(0)
  availablePerkPoints Int @default(0)
  prestigeLevel Int     @default(0)
  prestigePoints Int    @default(0)

  // Bars (Torn-style)
  health       Int      @default(100)
  maxHealth    Int      @default(100)
  energy       Int      @default(20)
  maxEnergy    Int      @default(20)
  nerve        Int      @default(10)
  maxNerve     Int      @default(10)
  happiness    Int      @default(50)
  maxHappiness Int      @default(50)

  // Level / XP
  level        Int      @default(1)
  xp           Int      @default(0)

  // Combat stats (trained in gym)
  strength     Int      @default(0)
  speed        Int      @default(0)
  defense      Int      @default(0)
  dexterity    Int      @default(0)

  // Timers
  lastEnergyTs DateTime @default(now())
  lastNerveTs  DateTime @default(now())
  lastHappinessTs DateTime @default(now())
  lastIncomeTs DateTime @default(now())
  lastHeatDecayAt DateTime @default(now())
  hospitalUntil DateTime @default("1970-01-01T00:00:00Z")
  shieldUntil  DateTime
  hospitalExitPenaltyUntil DateTime?
  hospitalExitPenaltyType String?

  pendingNonce String?

  // $SLS economy
  slsSpent             Float    @default(0)
  hospitalReleaseCount Int      @default(0)
  hospitalReleaseDate  DateTime?
}

model Item {
  id        String      @id @default(cuid())
  category  String      @default("unit")
  subCategory String?
  name      String
  atk       Int
  def       Int
  speed     Int         @default(0)
  dex       Int         @default(0)
  price     Int
  levelRequirement Int  @default(1)
  rarity    String?
  slot      String?
  description String?   @default("")
  effectType String?
  effectValue Float?
  effectDurationSecs Int?
  riskType String?
  riskValue Float?
  blackMarketOnly Boolean @default(false)
  consumable Boolean @default(false)
  stealable Boolean @default(true)
  tradable  Boolean @default(false)
  maxStack  Int?
  stackable Boolean     @default(true)
  isUnique  Boolean     @default(false)
  inventory Inventory[]
  protectionEffects ProtectionEffect[]
  blackMarketListings BlackMarketListing[]
  blackMarketPurchases BlackMarketPurchase[]
  missionRewards MissionDefinition[] @relation("MissionRewardItem")
}

model Inventory {
  userId String
  itemId String
  qty    Int    @default(0)
  expiresAt DateTime?
  sourceType String?
  equipped Boolean @default(false)
  durability Int?

  user User @relation(fields: [userId], references: [id])
  item Item @relation(fields: [itemId], references: [id])

  @@unique([userId, itemId])
}

model Battle {
  id         String   @id @default(cuid())
  attackerId String
  defenderId String?
  defenderType String  @default("player") // "player" | "npc"
  defenderNpcId String?
  defenderName String
  ts         DateTime @default(now())
  win        Boolean
  loot       Float
  rpDelta    Int
  xpGained   Int      @default(0)
  damageDealt Int     @default(0)
  damageTaken Int     @default(0)
  hospitalizedTarget Boolean @default(false)
  hospitalizedSelf Boolean   @default(false)
  aAP        Int
  dDP        Int

  attacker User @relation("Attacker", fields: [attackerId], references: [id])
  defender User? @relation("Defender", fields: [defenderId], references: [id])
}

model AttackCooldown {
  attackerId   String
  defenderId   String
  nextAttackTs DateTime

  attacker User @relation("CooldownAttacker", fields: [attackerId], references: [id])
  defender User @relation("CooldownDefender", fields: [defenderId], references: [id])

  @@unique([attackerId, defenderId])
}

model EventLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // "attack_win", "attack_loss", "attacked", "crime", "gym", "hospital", "level_up", "shop"
  message   String
  metadata  Json?
  ts        DateTime @default(now())
}

model AttackLog {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  createdAt          DateTime @default(now())
  type               String
  attackerId         String?
  defenderId         String?
  attackerName       String
  defenderName       String
  targetType         String   // "player" | "npc"
  result             String   // "win" | "loss"
  damageDealt        Int
  damageTaken        Int
  loot               Float
  cashStolen         Float   @default(0)
  heatChange         Int     @default(0)
  metadata           Json?
  rpChange           Int
  xpGained           Int
  hospitalResult     String   @default("none")
  revengeTargetId    String?
  revengeAvailable   Boolean  @default(false)
}

model Crime {
  id           String @id @default(cuid())
  name         String
  nerveCost    Int
  cashMin      Int
  cashMax      Int
  xpReward     Int
  successRate  Float  // 0.0 - 1.0
  levelReq     Int    @default(1)
}

model Syndicate {
  id          String            @id @default(cuid())
  name        String            @unique
  description String            @default("")
  buffType    String            @default("ap") // MVP: ap buff only
  buffValue   Float             @default(0.05)
  vaultCash   Float             @default(0)
  seasonPoints Int              @default(0)
  territoryCount Int            @default(0)
  warRating   Int               @default(1000)
  safehouseLevel Int            @default(1)
  leaderId    String            @unique
  leader      User              @relation("SyndicateLeader", fields: [leaderId], references: [id])
  creatorId   String?
  members     SyndicateMember[]
  territories TerritoryControl[]
  territoryContributions TerritoryContribution[]
  warsAsAttacker SyndicateWar[] @relation("WarAttacker")
  warsAsDefender SyndicateWar[] @relation("WarDefender")
  warsWon      SyndicateWar[]   @relation("WarWinner")
  warActions   SyndicateWarAction[]
  championshipEntries ChampionshipEntry[]
  championshipMatchesA ChampionshipMatch[] @relation("ChampionshipSyndicateA")
  championshipMatchesB ChampionshipMatch[] @relation("ChampionshipSyndicateB")
  championshipWins ChampionshipMatch[] @relation("ChampionshipWinner")
  hallOfFameEntries HallOfFameEntry[]
  createdAt   DateTime          @default(now())
}

model SyndicateMember {
  id          String    @id @default(cuid())
  syndicateId String
  userId      String    @unique
  role        String    @default("member")
  contributionScore Int @default(0)
  warParticipation Int  @default(0)
  lastActiveAt  DateTime @default(now())
  joinedAt    DateTime  @default(now())

  syndicate   Syndicate @relation(fields: [syndicateId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([syndicateId, userId])
}

model Territory {
  id         String   @id @default(cuid())
  name       String
  code       String   @unique
  bonusType  String
  bonusValue Float
  incomeType String?
  sortOrder  Int
  active     Boolean  @default(true)

  control        TerritoryControl?
  contributions  TerritoryContribution[]
  wars           SyndicateWar[]
}

model TerritoryControl {
  id             String   @id @default(cuid())
  territoryId    String
  syndicateId    String
  influence      Int      @default(0)
  capturedAt     DateTime
  lastDefendedAt DateTime
  decayState     String   @default("stable")
  createdAt      DateTime @default(now())

  territory Territory @relation(fields: [territoryId], references: [id])
  syndicate Syndicate @relation(fields: [syndicateId], references: [id])

  @@unique([territoryId])
}

model TerritoryContribution {
  id             String   @id @default(cuid())
  territoryId    String
  syndicateId    String
  userId         String
  actionType     String
  influenceDelta Int
  createdAt      DateTime @default(now())

  territory Territory @relation(fields: [territoryId], references: [id])
  syndicate Syndicate @relation(fields: [syndicateId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([territoryId, createdAt])
  @@index([syndicateId, createdAt])
}

model SyndicateWar {
  id                  String   @id @default(cuid())
  attackerSyndicateId String
  defenderSyndicateId String
  status              String
  startsAt            DateTime
  endsAt              DateTime
  attackerScore       Int      @default(0)
  defenderScore       Int      @default(0)
  territoryId         String?
  winnerSyndicateId   String?
  createdAt           DateTime @default(now())

  attackerSyndicate Syndicate @relation("WarAttacker", fields: [attackerSyndicateId], references: [id])
  defenderSyndicate Syndicate @relation("WarDefender", fields: [defenderSyndicateId], references: [id])
  territory         Territory? @relation(fields: [territoryId], references: [id])
  winnerSyndicate   Syndicate? @relation("WarWinner", fields: [winnerSyndicateId], references: [id])
  actions           SyndicateWarAction[]
}

model SyndicateWarAction {
  id         String   @id @default(cuid())
  warId       String
  userId      String
  syndicateId String
  actionType  String
  points      Int
  metadata    Json?
  createdAt   DateTime @default(now())

  war       SyndicateWar @relation(fields: [warId], references: [id])
  user      User         @relation(fields: [userId], references: [id])
  syndicate Syndicate    @relation(fields: [syndicateId], references: [id])

  @@index([warId, createdAt])
}

model SlsTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String   // "hospital_release"
  amount      Float    // $SLS amount
  usdValue    Float    // USD equivalent at time of tx
  description String
  createdAt   DateTime @default(now())
}

model ProtectionEffect {
  id           String   @id @default(cuid())
  userId       String
  type         String
  value        Float
  startsAt     DateTime
  endsAt       DateTime
  sourceItemId String?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id])
  sourceItem   Item?    @relation(fields: [sourceItemId], references: [id])

  @@index([userId, type])
  @@index([endsAt])
}

model BlackMarketRotation {
  id        String   @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  status    String
  theme     String?
  createdAt DateTime @default(now())

  listings  BlackMarketListing[]

  @@index([status, startsAt, endsAt])
}

model BlackMarketListing {
  id               String   @id @default(cuid())
  rotationId       String
  itemId           String
  basePrice        Float
  finalPrice       Float
  stock            Int
  remainingStock   Int
  riskPercent      Float    @default(0)
  requiredHeatMin  Int      @default(0)
  requiredLevelMin Int      @default(1)
  listingType      String
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  rotation         BlackMarketRotation @relation(fields: [rotationId], references: [id])
  item             Item                @relation(fields: [itemId], references: [id])
  purchases        BlackMarketPurchase[]

  @@index([rotationId, active])
  @@index([itemId])
}

model BlackMarketPurchase {
  id             String   @id @default(cuid())
  userId         String
  listingId      String
  itemId         String
  qty            Int
  pricePaid      Float
  heatGained     Int      @default(0)
  stingTriggered Boolean  @default(false)
  createdAt      DateTime @default(now())

  user           User               @relation(fields: [userId], references: [id])
  listing        BlackMarketListing @relation(fields: [listingId], references: [id])
  item           Item               @relation(fields: [itemId], references: [id])

  @@index([userId, createdAt])
  @@index([listingId])
}

model MissionDefinition {
  id           String   @id @default(cuid())
  type         String
  code         String   @unique
  name         String
  description  String
  goalType     String
  goalValue    Int
  rewardCash   Float    @default(0)
  rewardRp     Int      @default(0)
  rewardItemId String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  rewardItem     Item?           @relation("MissionRewardItem", fields: [rewardItemId], references: [id])
  playerMissions PlayerMission[]

  @@index([type, active])
}

model PlayerMission {
  id                  String   @id @default(cuid())
  userId              String
  missionDefinitionId String
  progress            Int      @default(0)
  completed           Boolean  @default(false)
  claimed             Boolean  @default(false)
  startsAt            DateTime
  endsAt              DateTime
  createdAt           DateTime @default(now())

  user              User              @relation(fields: [userId], references: [id])
  missionDefinition MissionDefinition @relation(fields: [missionDefinitionId], references: [id])

  @@index([userId, completed, claimed])
  @@index([userId, startsAt, endsAt])
}

model PerkDefinition {
  id                 String   @id @default(cuid())
  branch             String
  code               String   @unique
  name               String
  description        String
  effectType         String
  effectValue        Float
  tier               Int
  prerequisitePerkId String?
  active             Boolean  @default(true)

  prerequisitePerk   PerkDefinition?  @relation("PerkPrerequisite", fields: [prerequisitePerkId], references: [id])
  unlockedChildren   PerkDefinition[] @relation("PerkPrerequisite")
  playerPerks        PlayerPerk[]
}

model PlayerPerk {
  id               String   @id @default(cuid())
  userId           String
  perkDefinitionId String
  unlockedAt       DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id])
  perkDefinition PerkDefinition @relation(fields: [perkDefinitionId], references: [id])

  @@unique([userId, perkDefinitionId])
}

model RevengeMark {
  id             String   @id @default(cuid())
  victimUserId   String
  attackerUserId String
  battleId       String
  active         Boolean  @default(true)
  bonusPercent   Float    @default(0)
  expiresAt      DateTime
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())

  victim   User @relation("RevengeVictim", fields: [victimUserId], references: [id])
  attacker User @relation("RevengeAttacker", fields: [attackerUserId], references: [id])

  @@index([victimUserId, active])
  @@index([attackerUserId, active])
}

model Season {
  id              String   @id @default(cuid())
  name            String
  status          String
  startsAt        DateTime
  endsAt          DateTime
  rewardJson      Json?
  prestigeEnabled Boolean  @default(false)
  createdAt       DateTime @default(now())

  participations  SeasonParticipation[]
  snapshots       SeasonLeaderboardSnapshot[]
  prestigeHistory PrestigeHistory[]
  championshipSeason ChampionshipSeason?
  hallOfFameEntries HallOfFameEntry[]
}

model SeasonParticipation {
  id            String   @id @default(cuid())
  seasonId      String
  userId        String
  score         Int      @default(0)
  pvpScore      Int      @default(0)
  crimeScore    Int      @default(0)
  missionScore  Int      @default(0)
  finalRank     Int?
  rewardClaimed Boolean  @default(false)
  createdAt     DateTime @default(now())

  season Season @relation(fields: [seasonId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([seasonId, userId])
}

model SeasonLeaderboardSnapshot {
  id         String   @id @default(cuid())
  seasonId   String
  userId     String?
  rank       Int
  score      Int
  category   String
  capturedAt DateTime

  season Season @relation(fields: [seasonId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([seasonId, category, capturedAt])
}

model PrestigeHistory {
  id               String   @id @default(cuid())
  userId           String
  fromPrestige     Int
  toPrestige       Int
  seasonId         String?
  grantedBonusJson Json?
  createdAt        DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  season Season? @relation(fields: [seasonId], references: [id])

  @@index([userId, createdAt])
}

model ChampionshipSeason {
  id        String   @id @default(cuid())
  seasonId  String   @unique
  status    String
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())

  season  Season              @relation(fields: [seasonId], references: [id])
  entries ChampionshipEntry[]
  matches ChampionshipMatch[]
}

model ChampionshipEntry {
  id                    String   @id @default(cuid())
  championshipSeasonId  String
  syndicateId           String
  seed                  Int
  qualifyingPoints      Int
  createdAt             DateTime @default(now())

  championshipSeason ChampionshipSeason @relation(fields: [championshipSeasonId], references: [id])
  syndicate          Syndicate          @relation(fields: [syndicateId], references: [id])

  @@unique([championshipSeasonId, syndicateId])
}

model ChampionshipMatch {
  id                    String   @id @default(cuid())
  championshipSeasonId  String
  round                 Int
  syndicateAId          String
  syndicateBId          String
  scoreA                Int      @default(0)
  scoreB                Int      @default(0)
  winnerSyndicateId     String?
  startsAt              DateTime
  endsAt                DateTime
  status                String
  createdAt             DateTime @default(now())

  championshipSeason ChampionshipSeason @relation(fields: [championshipSeasonId], references: [id])
  syndicateA         Syndicate          @relation("ChampionshipSyndicateA", fields: [syndicateAId], references: [id])
  syndicateB         Syndicate          @relation("ChampionshipSyndicateB", fields: [syndicateBId], references: [id])
  winnerSyndicate    Syndicate?         @relation("ChampionshipWinner", fields: [winnerSyndicateId], references: [id])

  @@index([championshipSeasonId, round, status])
}

model HallOfFameEntry {
  id         String   @id @default(cuid())
  seasonId   String
  category   String
  userId     String?
  syndicateId String?
  rank       Int
  displayJson Json
  createdAt  DateTime @default(now())

  season    Season    @relation(fields: [seasonId], references: [id])
  user      User?     @relation(fields: [userId], references: [id])
  syndicate Syndicate? @relation(fields: [syndicateId], references: [id])

  @@index([seasonId, category, rank])
}
