generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  wallet    String   @unique
  createdAt DateTime @default(now())

  profile           Profile?
  inventory         Inventory[]
  attacksMade       Battle[]         @relation("Attacker")
  attacksReceived   Battle[]         @relation("Defender")
  cooldownsGiven    AttackCooldown[] @relation("CooldownAttacker")
  cooldownsReceived AttackCooldown[] @relation("CooldownDefender")
  events            EventLog[]
  attackLogs        AttackLog[]
  protectionEffects ProtectionEffect[]
  syndicateMembership SyndicateMember?
  ledSyndicate      Syndicate?        @relation("SyndicateLeader")
  slsTransactions   SlsTransaction[]
  blackMarketPurchases BlackMarketPurchase[]
  playerMissions    PlayerMission[]
}

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  name         String   @default("")
  cash         Float    @default(1000)
  vaultCash    Float    @default(0)
  rp           Int      @default(100)
  heat         Int      @default(0)
  wantedTier   String   @default("low")

  // Bars (Torn-style)
  health       Int      @default(100)
  maxHealth    Int      @default(100)
  energy       Int      @default(20)
  maxEnergy    Int      @default(20)
  nerve        Int      @default(10)
  maxNerve     Int      @default(10)
  happiness    Int      @default(50)
  maxHappiness Int      @default(50)

  // Level / XP
  level        Int      @default(1)
  xp           Int      @default(0)

  // Combat stats (trained in gym)
  strength     Int      @default(0)
  speed        Int      @default(0)
  defense      Int      @default(0)
  dexterity    Int      @default(0)

  // Timers
  lastEnergyTs DateTime @default(now())
  lastNerveTs  DateTime @default(now())
  lastHappinessTs DateTime @default(now())
  lastIncomeTs DateTime @default(now())
  lastHeatDecayAt DateTime @default(now())
  hospitalUntil DateTime @default("1970-01-01T00:00:00Z")
  shieldUntil  DateTime
  hospitalExitPenaltyUntil DateTime?
  hospitalExitPenaltyType String?

  pendingNonce String?

  // $SLS economy
  slsSpent             Float    @default(0)
  hospitalReleaseCount Int      @default(0)
  hospitalReleaseDate  DateTime?
}

model Item {
  id        String      @id @default(cuid())
  category  String      @default("unit")
  subCategory String?
  name      String
  atk       Int
  def       Int
  speed     Int         @default(0)
  dex       Int         @default(0)
  price     Int
  levelRequirement Int  @default(1)
  rarity    String?
  description String?   @default("")
  effectType String?
  effectValue Float?
  effectDurationSecs Int?
  riskType String?
  riskValue Float?
  blackMarketOnly Boolean @default(false)
  consumable Boolean @default(false)
  stealable Boolean @default(true)
  stackable Boolean     @default(true)
  isUnique  Boolean     @default(false)
  inventory Inventory[]
  protectionEffects ProtectionEffect[]
  blackMarketListings BlackMarketListing[]
  blackMarketPurchases BlackMarketPurchase[]
  missionRewards MissionDefinition[] @relation("MissionRewardItem")
}

model Inventory {
  userId String
  itemId String
  qty    Int    @default(0)
  expiresAt DateTime?
  sourceType String?

  user User @relation(fields: [userId], references: [id])
  item Item @relation(fields: [itemId], references: [id])

  @@unique([userId, itemId])
}

model Battle {
  id         String   @id @default(cuid())
  attackerId String
  defenderId String?
  defenderType String  @default("player") // "player" | "npc"
  defenderNpcId String?
  defenderName String
  ts         DateTime @default(now())
  win        Boolean
  loot       Float
  rpDelta    Int
  xpGained   Int      @default(0)
  damageDealt Int     @default(0)
  damageTaken Int     @default(0)
  hospitalizedTarget Boolean @default(false)
  hospitalizedSelf Boolean   @default(false)
  aAP        Int
  dDP        Int

  attacker User @relation("Attacker", fields: [attackerId], references: [id])
  defender User? @relation("Defender", fields: [defenderId], references: [id])
}

model AttackCooldown {
  attackerId   String
  defenderId   String
  nextAttackTs DateTime

  attacker User @relation("CooldownAttacker", fields: [attackerId], references: [id])
  defender User @relation("CooldownDefender", fields: [defenderId], references: [id])

  @@unique([attackerId, defenderId])
}

model EventLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // "attack_win", "attack_loss", "attacked", "crime", "gym", "hospital", "level_up", "shop"
  message   String
  metadata  Json?
  ts        DateTime @default(now())
}

model AttackLog {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  createdAt          DateTime @default(now())
  type               String
  attackerId         String?
  defenderId         String?
  attackerName       String
  defenderName       String
  targetType         String   // "player" | "npc"
  result             String   // "win" | "loss"
  damageDealt        Int
  damageTaken        Int
  loot               Float
  cashStolen         Float   @default(0)
  heatChange         Int     @default(0)
  metadata           Json?
  rpChange           Int
  xpGained           Int
  hospitalResult     String   @default("none")
  revengeTargetId    String?
  revengeAvailable   Boolean  @default(false)
}

model Crime {
  id           String @id @default(cuid())
  name         String
  nerveCost    Int
  cashMin      Int
  cashMax      Int
  xpReward     Int
  successRate  Float  // 0.0 - 1.0
  levelReq     Int    @default(1)
}

model Syndicate {
  id          String            @id @default(cuid())
  name        String            @unique
  description String            @default("")
  buffType    String            @default("ap") // MVP: ap buff only
  buffValue   Float             @default(0.05)
  leaderId    String            @unique
  leader      User              @relation("SyndicateLeader", fields: [leaderId], references: [id])
  members     SyndicateMember[]
  createdAt   DateTime          @default(now())
}

model SyndicateMember {
  id          String    @id @default(cuid())
  syndicateId String
  userId      String    @unique
  role        String    @default("member")
  joinedAt    DateTime  @default(now())

  syndicate   Syndicate @relation(fields: [syndicateId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([syndicateId, userId])
}

model SlsTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String   // "hospital_release"
  amount      Float    // $SLS amount
  usdValue    Float    // USD equivalent at time of tx
  description String
  createdAt   DateTime @default(now())
}

model ProtectionEffect {
  id           String   @id @default(cuid())
  userId       String
  type         String
  value        Float
  startsAt     DateTime
  endsAt       DateTime
  sourceItemId String?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id])
  sourceItem   Item?    @relation(fields: [sourceItemId], references: [id])

  @@index([userId, type])
  @@index([endsAt])
}

model BlackMarketRotation {
  id        String   @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  status    String
  theme     String?
  createdAt DateTime @default(now())

  listings  BlackMarketListing[]

  @@index([status, startsAt, endsAt])
}

model BlackMarketListing {
  id               String   @id @default(cuid())
  rotationId       String
  itemId           String
  basePrice        Float
  finalPrice       Float
  stock            Int
  remainingStock   Int
  riskPercent      Float    @default(0)
  requiredHeatMin  Int      @default(0)
  requiredLevelMin Int      @default(1)
  listingType      String
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  rotation         BlackMarketRotation @relation(fields: [rotationId], references: [id])
  item             Item                @relation(fields: [itemId], references: [id])
  purchases        BlackMarketPurchase[]

  @@index([rotationId, active])
  @@index([itemId])
}

model BlackMarketPurchase {
  id             String   @id @default(cuid())
  userId         String
  listingId      String
  itemId         String
  qty            Int
  pricePaid      Float
  heatGained     Int      @default(0)
  stingTriggered Boolean  @default(false)
  createdAt      DateTime @default(now())

  user           User               @relation(fields: [userId], references: [id])
  listing        BlackMarketListing @relation(fields: [listingId], references: [id])
  item           Item               @relation(fields: [itemId], references: [id])

  @@index([userId, createdAt])
  @@index([listingId])
}

model MissionDefinition {
  id           String   @id @default(cuid())
  type         String
  code         String   @unique
  name         String
  description  String
  goalType     String
  goalValue    Int
  rewardCash   Float    @default(0)
  rewardRp     Int      @default(0)
  rewardItemId String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  rewardItem     Item?           @relation("MissionRewardItem", fields: [rewardItemId], references: [id])
  playerMissions PlayerMission[]

  @@index([type, active])
}

model PlayerMission {
  id                  String   @id @default(cuid())
  userId              String
  missionDefinitionId String
  progress            Int      @default(0)
  completed           Boolean  @default(false)
  claimed             Boolean  @default(false)
  startsAt            DateTime
  endsAt              DateTime
  createdAt           DateTime @default(now())

  user              User              @relation(fields: [userId], references: [id])
  missionDefinition MissionDefinition @relation(fields: [missionDefinitionId], references: [id])

  @@index([userId, completed, claimed])
  @@index([userId, startsAt, endsAt])
}
