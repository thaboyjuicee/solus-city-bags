# ─── Database ────────────────────────────────────────────────────────────────

# PostgreSQL connection string used by Prisma at runtime.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/soluscity

# Public-facing database URL exposed by Railway's TCP proxy.
# Only needed when deploying to Railway; leave blank for local development.
DATABASE_PUBLIC_URL=

# ─── Auth ─────────────────────────────────────────────────────────────────────

# Secret used to sign and verify JWTs. Must be at least 32 characters.
JWT_SECRET=your_jwt_secret_at_least_32_characters_long_here

# ─── Server ───────────────────────────────────────────────────────────────────

# Node environment. Use "development" locally, "production" in deployment.
NODE_ENV=development

# Port the Fastify server listens on.
PORT=3000

# Allowed CORS origin for browser requests. Use "*" during local development,
# or set to your frontend URL in production (e.g. https://yourapp.vercel.app).
CORS_ORIGIN=*

# ─── Rate Limiting ────────────────────────────────────────────────────────────

# Time window for rate limiting in milliseconds (default: 60000 = 1 minute).
RATE_LIMIT_WINDOW_MS=60000

# Maximum number of requests allowed per window per IP (default: 120).
RATE_LIMIT_MAX=120

# ─── Bags SDK ─────────────────────────────────────────────────────────────────

# API key for the Bags trade SDK, used to proxy swap quotes and build
# swap transactions for the frontend. Obtain at https://bags.fm.
BAGS_API_KEY=your_bags_api_key_here

# ─── Helius RPC ───────────────────────────────────────────────────────────────

# Helius RPC endpoint for Solana mainnet, used by the Bags SDK internally.
# If omitted, falls back to the default public mainnet-beta cluster (rate-limited).
# Obtain an API key at https://helius.dev.
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here
