# Copy this file to .env.local and fill in values

# Backend API base URL for local development
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# NEXT_PUBLIC_API_BASE_URL=https://solus-city-server-production.up.railway.app

# Railway deployment example:
# NEXT_PUBLIC_API_BASE_URL=https://${{Backend.RAILWAY_PUBLIC_DOMAIN}}

# Solana network: mainnet-beta | devnet | testnet
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# Helius RPC URL for on-chain reads (token balances, SOL balance)
NEXT_PUBLIC_HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# Bags API key for the $SLX swap tab (get one at dev.bags.fm)
NEXT_PUBLIC_BAGS_API_KEY=YOUR_BAGS_API_KEY

