# Copy this file to .env.local and fill in your values.

# ─── Backend API ──────────────────────────────────────────────────────────────

# Base URL of the Solus City backend server.
# Use localhost for local development, or your Railway/deployed URL in production.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Production example (Railway):
# NEXT_PUBLIC_API_BASE_URL=https://your-railway-backend-url.up.railway.app

# ─── Solana ───────────────────────────────────────────────────────────────────

# Solana network to connect to. Options: mainnet-beta | devnet | testnet
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# Helius RPC endpoint for on-chain reads (SOL balance, token balances, etc.).
# If omitted, falls back to the default public mainnet-beta cluster (rate-limited).
# Obtain an API key at https://helius.dev.
NEXT_PUBLIC_HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here

# ─── Bags SDK ─────────────────────────────────────────────────────────────────

# API key for the Bags trade SDK, used by the SOL → $SLS swap tab in the shop.
# Obtain at https://bags.fm.
NEXT_PUBLIC_BAGS_API_KEY=your_bags_api_key_here
